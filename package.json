{
  "name": "commons-collective",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-linked research and a transparent commons-collective demonstrator.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pdf": "node scripts/generate-pdf.mjs",
    "test:pdf": "python test/pdf-validation.py",
    "test": "node --test \"test/*.test.mjs\"",
    "preview": "python -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "audit:usage": "python scripts/capture-ai-usage.py"
  },
  "dependencies": {
    "marked": "18.0.12",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "jsqr": "1.4.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0"
  }
}
